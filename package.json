{
  "name": "flex-auth",
  "version": "2.0.0",
  "description": "Framework auth Node.js + TypeScript tanpa dependency: HTTP server, JWT, password hashing, OTP, dan Google Sheets semuanya dari modul bawaan Node.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/src"],
  "engines": { "node": ">=20.6" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "start": "tsc && node dist/example/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
