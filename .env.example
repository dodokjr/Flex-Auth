# Jika memakai ENV, ubah JWT_SECRET_SOURCE menjadi 'env' di AuthPage/Jwt.ts.
# File .env dimuat oleh Node process.loadEnvFile (Node >=20.12) jika tersedia.
PORT=3000

# Secret JWT: minimal 32 karakter, acak, dan access & refresh HARUS berbeda.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-minimal-32-karakter-A
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter-B

# memory | sheets
STORAGE=memory

# Hanya jika STORAGE=sheets
GOOGLE_SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KEY_ANDA\n-----END PRIVATE KEY-----\n"
